{
  "schemaVersion": 1,
  "id": "warlockery",
  "version": "${version}",
  "name": "Warlockery",
  "description": "A standalone ritual-magic mod with circle rites, magical machines and plants, sympathetic dolls, supernatural transformations, creatures, bosses, goblin settlements, and modern ore progression.",
  "authors": [
    "Kadamitas"
  ],
  "contact": {
    "homepage": "https://github.com/Kadamitas/Warlockery",
    "sources": "https://github.com/Kadamitas/Warlockery",
    "issues": "https://github.com/Kadamitas/Warlockery/issues"
  },
  "license": "MIT",
  "icon": "assets/warlockery/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kadamitas.warlockery.Warlockery"
    ],
    "client": [
      "com.kadamitas.warlockery.client.WarlockeryClient"
    ],
    "jei_mod_plugin": [
      "com.kadamitas.warlockery.compat.jei.WarlockeryJeiPlugin"
    ],
    "rei_client": [
      "com.kadamitas.warlockery.compat.rei.WarlockeryReiPlugin"
    ],
    "rrv_client": [
      "com.kadamitas.warlockery.compat.rrv.WarlockeryRrvPlugin"
    ],
    "emi": [
      "com.kadamitas.warlockery.compat.emi.WarlockeryEmiPlugin"
    ]
  },
  "mixins": [
    "warlockery.mixins.json"
  ],
  "depends": {
    "quilt_loader": ">=0.30.1",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.161.0+26.3",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "suggests": {
    "jei": "*",
    "roughlyenoughitems": "*",
    "rrv": "*",
    "emi": "*"
  }
}
