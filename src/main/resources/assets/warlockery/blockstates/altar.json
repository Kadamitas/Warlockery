{
  "multipart": [
    {
      "apply": {
        "model": "warlockery:block/altar_top"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "warlockery:block/altar_apron",
        "y": 0
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "warlockery:block/altar_apron",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "warlockery:block/altar_apron",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "warlockery:block/altar_apron",
        "y": 270
      }
    },
    {
      "when": {
        "north": "false",
        "west": "false"
      },
      "apply": {
        "model": "warlockery:block/altar_leg",
        "y": 0
      }
    },
    {
      "when": {
        "north": "false",
        "east": "false"
      },
      "apply": {
        "model": "warlockery:block/altar_leg",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false",
        "east": "false"
      },
      "apply": {
        "model": "warlockery:block/altar_leg",
        "y": 180
      }
    },
    {
      "when": {
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "warlockery:block/altar_leg",
        "y": 270
      }
    }
  ]
}
