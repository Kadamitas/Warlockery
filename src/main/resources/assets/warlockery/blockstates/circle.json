{
  "multipart": [
    {
      "apply": {
        "model": "warlockery:block/circle"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "warlockery:block/circle_north"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "warlockery:block/circle_east"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "warlockery:block/circle_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "warlockery:block/circle_west"
      }
    },
    {
      "when": {
        "north_east": "true"
      },
      "apply": {
        "model": "warlockery:block/circle_north_east"
      }
    },
    {
      "when": {
        "south_east": "true"
      },
      "apply": {
        "model": "warlockery:block/circle_south_east"
      }
    },
    {
      "when": {
        "south_west": "true"
      },
      "apply": {
        "model": "warlockery:block/circle_south_west"
      }
    },
    {
      "when": {
        "north_west": "true"
      },
      "apply": {
        "model": "warlockery:block/circle_north_west"
      }
    }
  ]
}
